# VortexFS Configuration Settings

# App Environment
VORTEX_ENVIRONMENT=development
VORTEX_DEBUG=true

# Server Configuration
VORTEX_API_HOST=0.0.0.0
VORTEX_API_PORT=8000

# Storage Backends
# Online Store: 'memory' (ultra-fast zero dependency) or 'redis' (production distributed)
VORTEX_ONLINE_STORE_TYPE=memory
VORTEX_REDIS_URL=redis://localhost:6379/0

# Offline Store: 'duckdb' (high-performance embedded OLAP) or 'clickhouse' (production scale-out)
VORTEX_OFFLINE_STORE_TYPE=duckdb
VORTEX_DUCKDB_PATH=data/vortex_offline.duckdb

# ClickHouse Configuration (if VORTEX_OFFLINE_STORE_TYPE=clickhouse)
VORTEX_CLICKHOUSE_HOST=localhost
VORTEX_CLICKHOUSE_PORT=9000
VORTEX_CLICKHOUSE_USER=default
VORTEX_CLICKHOUSE_PASSWORD=
VORTEX_CLICKHOUSE_DB=vortex

# Stream Buffer Settings
VORTEX_INGESTION_BATCH_SIZE=500
VORTEX_INGESTION_FLUSH_INTERVAL_SEC=1.0
